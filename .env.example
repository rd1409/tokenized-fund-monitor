# Turso: from the database page (URL) and "Create token" (auth token)
TURSO_DATABASE_URL=libsql://tokenized-fund-monitor-<your-org>.turso.io
TURSO_AUTH_TOKEN=

# Any long random string. Unlocks /admin actions.
ADMIN_TOKEN=

# Any long random string. Vercel sends it with each scheduled T-bill refresh.
CRON_SECRET=
